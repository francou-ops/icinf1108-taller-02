            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Otra Persona\",\n  \"username\": \"{{studentUsername}}\",\n  \"email\": \"otra_persona_01@example.com\",\n  \"age\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
