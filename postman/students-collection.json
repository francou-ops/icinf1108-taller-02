          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('Error en name', function () { pm.expect(pm.response.json().errors.name).to.exist; });"
                ]
