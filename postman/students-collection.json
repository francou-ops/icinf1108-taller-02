                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error en age', function () { pm.expect(pm.response.json().errors.age).to.exist; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
