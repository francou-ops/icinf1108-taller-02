    {
      "name": "04 - Final integration",
      "description": "Ejecutar solo tras integrar Alembic, la FK y el borrado transaccional. El estudiante de esta colección conserva una mascota para esta prueba.",
      "item": [
        {
          "name": "Delete Student with Pet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "Check Student removed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        }
      ]
    }
  ]
}
