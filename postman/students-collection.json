                  "pm.test('Error en email', function () { pm.expect(pm.response.json().errors.email).to.exist; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/students",
            "header": [
              {
